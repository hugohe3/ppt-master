  "modes": [
    {
      "id": "pyramid",
      "label": "pyramid",
      "label_zh": "金字塔",
      "label_zh_tw": "金字塔",
      "label_en": "pyramid",
      "label_ja": "ピラミッド",
      "desc_zh": "结论先行；材料支持时采用相互独立、完全穷尽的论证，并为数据配上有依据的对比。适合决策、分析、战略、汇报。",
      "desc_zh_tw": "結論先行；材料支持時採用相互獨立、完全窮盡的論證，並為數據配上有依據的對比。適合決策、分析、策略、報告。",
      "desc_en": "Lead with the answer, use MECE reasoning where the source supports it, and give data a supported comparison where useful. Best for decisions, analysis, strategy, and reporting.",
      "desc_ja": "結論を先に示し、元資料が裏付ける範囲でMECEな論理構成をとり、根拠のある比較で数値の意味を示す。意思決定・分析・戦略・報告に最適。"
    },
    {
      "id": "narrative",
      "label": "narrative",
      "label_zh": "叙事",
      "label_zh_tw": "敘事",
      "label_en": "narrative",
      "label_ja": "ナラティブ",
      "desc_zh": "从情境到张力再到化解，形成故事弧线，保留悬念与转折。适合路演、案例、品牌故事、融资。",
      "desc_zh_tw": "情境、張力、解決方案形成故事弧線，保留懸念與轉折。適合路演、案例、品牌、募資。",
      "desc_en": "Build a story arc from context to tension to resolution, with suspense and turns. Best for roadshows, cases, brand stories, and fundraising.",
      "desc_ja": "状況設定から緊張、解決へと物語の流れを組み立て、先が気になる展開や転換を残す。ピッチ・事例紹介・ブランドストーリー・資金調達向け。"
    },
    {
      "id": "instructional",
      "label": "instructional",
      "label_zh": "教学",
      "label_zh_tw": "教學",
      "label_en": "instructional",
      "label_ja": "教育・解説",
      "desc_zh": "概念拆解、分步推进、并列讲解。适合培训、教程、科普、知识分享。",
      "desc_zh_tw": "概念拆解、分步推進、並列講解。適合培訓、教學、科普、知識分享。",
      "desc_en": "Break concepts down, advance step by step, and explain parallel ideas clearly. Best for training, tutorials, popular science, and knowledge sharing.",
      "desc_ja": "概念を分解し、段階的に進め、並列する要素を明確に説明する。研修・チュートリアル・科学解説・知識共有に最適。"
    },
    {
      "id": "showcase",
      "label": "showcase",
      "label_zh": "展演",
      "label_zh_tw": "展演",
      "label_en": "showcase",
      "label_ja": "ショーケース",
      "desc_zh": "视觉主导，大图、大数字和情绪节奏优先。适合发布会、品牌秀、活动。",
      "desc_zh_tw": "視覺主導，大圖、大數和情緒節奏優先。適合發表、品牌秀、活動。",
      "desc_en": "Lead visually with large images, strong numbers, and emotional rhythm. Best for launches, brand showcases, and events.",
      "desc_ja": "ビジュアル主導で、大きな画像・インパクトのある数字・感情のリズムを優先する。製品発表・ブランド紹介・イベント向け。"
    },
    {
      "id": "briefing",
      "label": "briefing",
      "label_zh": "简报",
      "label_zh_tw": "簡報",
      "label_en": "briefing",
      "label_ja": "ブリーフィング",
      "desc_zh": "中性完整、便于速览，采用主题式标题和均匀权重。适合周报、参考材料、常见问题、会议资料。",
      "desc_zh_tw": "中性完整、便於速覽，採用主題式標題和均勻權重。適合週報、參考資料、常見問題、會議簡報。",
      "desc_en": "Stay neutral, complete, and scannable with topical headings and balanced weight. Best for weekly reports, reference packs, FAQs, and meeting decks.",
      "desc_ja": "中立的で漏れがなく、ざっと目を通しやすい構成。話題ごとに見出しを立て、各項目を均等な比重で扱う。週次報告・参考資料・FAQ・会議資料に最適。"
    }
  ],
